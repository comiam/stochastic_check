[flake8]
# Mirrors [tool.flake8] in pyproject.toml.  flake8 does not natively
# read pyproject.toml without the Flake8-pyproject plugin, so we keep
# this file as the authoritative config consumed by `make lint`.
max-line-length = 88
extend-ignore = E203, E501, W503, E741
exclude = .venv, .git, __pycache__, build, dist, *.egg-info
per-file-ignores =
    __init__.py:F401
